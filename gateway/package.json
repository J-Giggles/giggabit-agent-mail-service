{
  "name": "@giggabit/agent-mail-service",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J-Giggles/giggabit-agent-mail-service.git",
    "directory": "gateway"
  },
  "homepage": "https://github.com/J-Giggles/giggabit-agent-mail-service#readme",
  "bugs": {
    "url": "https://github.com/J-Giggles/giggabit-agent-mail-service/issues"
  },
  "packageManager": "bun@1.3.9",
  "type": "module",
  "bin": {
    "giggabit-agent-mail-service": "dist/service-main.js",
    "giggabit-agent-mail-service-agent": "dist/launcher-main.js",
    "giggabit-agent-mail-service-admin": "dist/admin-main.js"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "overrides": {
    "@hono/node-server": ">=1.19.15",
    "fast-uri": ">=3.1.6",
    "hono": ">=4.13.5",
    "ip-address": ">=10.3.1",
    "nanoid": ">=3.3.18",
    "nodemailer": "9.1.1",
    "postcss": ">=8.5.23",
    "qs": ">=6.16.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && vitest run",
